# Copy this file to .env. Each developer should use a separate API key.
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4.1-mini
OPENAI_MODEL_CRITIC=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
# Safety limits. Do not raise these without team review.
OPENAI_MAX_CALLS_PER_RUN=3
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_MAX_INPUT_CHARACTERS=20000
